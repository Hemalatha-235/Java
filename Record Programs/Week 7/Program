
import java.util.Scanner;

class RBI {
    public double getRateOfInterest() {
        return 4.0;
    }
}

class SBI extends RBI {
    @Override
    public double getRateOfInterest() {
        return 7.0;
    }
}

class ICICI extends RBI {
    @Override
    public double getRateOfInterest() {
        return 6.5;
    }
}

class PNB extends RBI {
    @Override
    public double getRateOfInterest() {
        return 6.0;
    }
}

class Customer {
    String name;
    String bankName;
    Customer(String name, String bankName) {
        this.name = name;
        this.bankName = bankName;
    }
}

public class BankDemo {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the Bank name to find the rate of Interest : ");
        String bankName = sc.nextLine();

        RBI bank;
        switch (bankName.toUpperCase()) {
            case "SBI": bank = new SBI(); break;
            case "ICICI": bank = new ICICI(); break;
            case "PNB": bank = new PNB(); break;
            default: bank = new RBI(); break;
        }

        System.out.println(bankName + " rate of interest is : " + bank.getRateOfInterest() + "%");
        sc.close();
    }
}
